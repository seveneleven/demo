@page
@using Moryx.Asp.Integration
@using System.ComponentModel.DataAnnotations
@{
    ViewData["Title"] = "CustomModule";
    ViewData["BaseRef"] = "CustomModule/";

    Layout = "_Layout";
}

@* This lines defines the text which appears in the navigation bar for your module as well as its icon and description *@
@attribute [WebModule("CustomModule", "bolt"), Display(Name = "Custom Module", Description = "Module to demonstrate how to create custom UIs")]

@* // Styles from the angular project *@
@section Styles {
    <link rel="stylesheet" href="/_content/PencilFactory.CustomModule.Web/styles.css">
}

@* // Compiled javascript from the angular project *@
@section Scripts
{
    <script src="/_content/PencilFactory.CustomModule.Web/runtime.js" type="module"></script>
    <script src="/_content/PencilFactory.CustomModule.Web/polyfills.js" type="module"></script>
    <script src="/_content/PencilFactory.CustomModule.Web/main.js" type="module"></script>
}

@* // application root *@
<app-root></app-root>
